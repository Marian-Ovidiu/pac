# PAC runtime configuration. Copy to .env; never commit real values.
# Server-level environment variables take precedence over values in this file.
WP_ENVIRONMENT_TYPE=local
DB_NAME=pac
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_TABLE_PREFIX=wp_
WP_HOME=http://pac.local
WP_SITEURL=http://pac.local

# Replace every value in production with an independently generated secret.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# PAC application configuration.
TEST_PUBLISHABLE_KEY=
TEST_SECRET_KEY=

# Production-only values may be supplied by the hosting environment or root .env.
PUBLISHABLE_KEY=
SECRET_KEY=

# Signing secret for POST /wp-json/pac/v1/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
